---
import Header from '../components/Header.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'I ching', description = 'An assistant for I ching reading' } = Astro.props as Props;
---

<!DOCTYPE html>
<html lang="en" class="bg-white dark:bg-black text-black dark:text-white box-border">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="max-w-screen overflow-x-hidden">
    <Header />
    <main class="flex flex-col items-center justify-center min-h-[calc(100dvh-85px)] w-screen mt-[85px] p-6">
      <slot />
    </main>
  </body>
</html>
