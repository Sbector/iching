---
import Layout from '../../layouts/Layout.astro';
import { allHexagrams } from '../../data/hexagrams';

const title = 'Hexagrams | I Ching';
const description = 'All 64 hexagrams of the I Ching with their meanings';

// Book order (traditional arrangement by trigrams)
const BOOK_ORDER = [1, 44, 13, 10, 9, 14, 43, 33, 25, 61, 26, 34, 6, 37, 38, 5, 57, 30, 58, 50, 49, 28, 12, 42, 41, 11, 59, 22, 54, 53, 21, 60, 18, 55, 56, 17, 32, 31, 47, 48, 63, 64, 20, 27, 19, 4, 36, 52, 51, 35, 3, 46, 62, 45, 29, 39, 40, 24, 7, 15, 16, 8, 23, 2];
const hexagramsInOrder = BOOK_ORDER.map(num => allHexagrams[num]);
---

<Layout {title} {description}>
  <div class="py-8">
    <h1 class="title">The 64 Hexagrams</h1>
    <p class="text-muted-text mb-8">
      Click any hexagram to view details about its meaning and trigram composition
    </p>

    <div class="grid grid-cols-4 gap-4 sm:grid-cols-6 md:grid-cols-8">
      {hexagramsInOrder.map((hexagram) => (
        <a
          href={`/hexagrams/${hexagram.number}`}
          class="flex flex-col items-center p-4 bg-surface rounded-lg border border-border hover:border-accent hover:shadow-lg transition-all"
        >
          <div class="text-4xl mb-2">{hexagram.unicodeSymbol}</div>
          <div class="text-xs font-semibold text-foreground text-center">#{hexagram.number}</div>
          <div class="text-xs text-muted-text text-center">{hexagram.name}</div>
        </a>
      ))}
    </div>
  </div>
</Layout>
