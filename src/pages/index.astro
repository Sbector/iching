---
import Layout from '../layouts/Layout.astro';

const title = 'I ching';
const description = 'An assistant for I ching reading';
---

<Layout {title} {description}>
  <div class="text-center">
    <h1 class="title">Welcome!</h1>
    <h2 class="subtitle">Do you have a question for the I ching?</h2>
    <div class="mx-auto">
      <a href="/consult">
        <button class="bg-button-bg text-button-text hover:bg-button-hover active:shadow-sm shadow-md transition-all rounded-md m-3 px-2 py-2">
          I have a question
        </button>
      </a>
      <a href="/about">
        <button class="bg-button-bg text-button-text hover:bg-button-hover active:shadow-sm shadow-md transition-all rounded-md m-3 px-2 py-2">
          What is iching?
        </button>
      </a>
    </div>
  </div>
</Layout>
