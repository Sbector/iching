---
import Layout from '../layouts/Layout.astro';
import ConsultFlow from '../components/ConsultFlow.jsx';

const title = 'Consult | I ching';
const description = 'Consult the I ching with our consultation tool';
---

<Layout {title} {description}>
  <div class="py-8">
    <h1 class="title">Consult the I Ching</h1>
    <p class="text-muted-text mb-8">Take a sincere question and let the I Ching guide your reading</p>
    <ConsultFlow client:load />
  </div>
</Layout>
