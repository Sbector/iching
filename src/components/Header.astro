---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  {
    label: 'home',
    route: '/'
  },
  {
    label: 'about',
    route: '/about'
  },
  {
    label: 'instructions',
    route: '/instructions'
  },
  {
    label: 'consult',
    route: '/consult'
  }
];
---

<header class="fixed top-0 z-50 w-screen h-header-height bg-nav-bg text-center border-b border-border">
  <div class="py-3 flex items-center justify-between px-4">
    <a href="/" class="text-foreground text-3xl font-semibold flex-1">
      I ching <span class="text-2xl">online</span>
    </a>
    <ThemeToggle />
  </div>
  <nav class="relative mx-4">
    <ul class="flex flex-wrap bg-surface rounded-lg max-w-md mx-auto px-4">
      {links.map(({ label, route }) => (
        <li class="flex-auto mx-1">
          <a href={route} class="text-muted-text hover:text-accent transition-colors">
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
